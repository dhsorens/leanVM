def transcript.ProverState.add_round_poly
  {F : Type _} {S : Type _} (ScalarInst : Scalar F) (SearchInst : Search S)
  (self : transcript.ProverState F S) (coeffs : Slice F) (eq : Bool) :
  RustM (transcript.ProverState F S)
  := do
  let i ← core.slice.Slice.len coeffs
  massert (i >= 2#usize)
  let fixed ← core.Usize.Insts.CoreConvertFromBool.from (¬ eq)
  let i1 ← core.slice.Slice.iter coeffs
  let iter ←
    core.iter.traits.iterator.Iterator.enumerate.default
      (core.slice.iter.Iter.Insts.CoreIterTraitsIteratorIteratorSharedAT F) i1
  let self1 ←
    transcript.ProverState.add_round_poly_loop ScalarInst SearchInst iter self
      fixed
  let i2 ← core.slice.Slice.len coeffs
  let i3 ← i2 - 1#usize
  let i4 ← core.Usize.Insts.CoreConvertFromBool.from eq
  let i5 ← i3 + i4
  let i6 ← lift (UScalar.cast .U128 i5)
  let i7 ← verifier.transcript.grinding_bits i6
  transcript.ProverState.grind ScalarInst SearchInst self1 i7

