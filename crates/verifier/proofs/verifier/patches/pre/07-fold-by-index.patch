+/// A level-0 row's fold: lane `t` is the row's word `n - 1 - t`, the prover having laid the lanes out in reverse.
+fn base_fold(row: &[K], lane_weights: &[E]) -> E {
+    assert_eq!(row.len(), lane_weights.len());
+    let n = row.len();
+    let mut sum = ZERO;
+    for t in 0..n {
+        sum += lane_weights[t] * row[n - 1 - t];
+    }
+    sum
 }
 
