+/// The 16 bytes at `at`.
+fn digest_at(bytes: &[u8], at: usize) -> Digest {
+    bytes[at..at + N].try_into().unwrap()
+}
+
+/// The opening of one tree serialized at `at`.
+fn tree_from_bytes(bytes: &[u8], at: usize) -> TreeOpening {
+    let subtree = (FOREST_CHAINS + SUBTREE_HEIGHT) * N;
+    let path_at = at + SUBTREES * subtree;
+    TreeOpening {
+        subtrees: std::array::from_fn(|j| subtree_from_bytes(bytes, at + j * subtree)),
+        path: std::array::from_fn(|i| digest_at(bytes, path_at + i * N)),
+    }
+}
+
+/// The opening of one subtree serialized at `at`.
+fn subtree_from_bytes(bytes: &[u8], at: usize) -> SubtreeOpening {
+    let path_at = at + FOREST_CHAINS * N;
+    SubtreeOpening {
+        values: std::array::from_fn(|i| digest_at(bytes, at + i * N)),
+        path: std::array::from_fn(|i| digest_at(bytes, path_at + i * N)),
+    }
+}
