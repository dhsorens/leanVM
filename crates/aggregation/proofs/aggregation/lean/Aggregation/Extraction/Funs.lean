  RustM (alloc.vec.Vec stable_primitives.field.gf2_64x2.F128)
  := do
  massert (n > 0#usize)
  let i ← statement.CLAIM_BIG
  let rest ← n % i
  let i1 ← n / i
  let f ← cells.count i1
  let i2 ← rest / statement.CLAIM_GROUP
  let f1 ← cells.count i2
  let i3 ← rest % statement.CLAIM_GROUP
  let f2 ← cells.count i3
  let y ←
    lift (Std.Array.to_slice (Array.make 3#usize [ f, f1, f2 ] : Array
      stable_primitives.field.gf2_64x2.F128 3#usize))
  alloc.slice.Slice.into_vec y

