+/// The siblings authenticating the leaves at `active`, level by level.
+fn octopus(tree: &[Hash], num_leaves: usize, mut active: Vec<usize>) -> Vec<Hash> {
+    let mut sibling_hashes = Vec::new();
+    let (mut level_start, mut level_len) = (0usize, num_leaves);
+    while level_len > 1 {
+        // `next` stays sorted-unique: sibling pairs collapse to one parent,
+        // and `p >> 1` is otherwise strictly increasing.
+        active = prune_level(tree, level_start, &active, &mut sibling_hashes);
+        level_start += level_len;
+        level_len >>= 1;
+    }
+    sibling_hashes
+}
+
+/// The parents of one level's `active` positions, pushing the siblings not among them.
+fn prune_level(tree: &[Hash], level_start: usize, active: &[usize], sibling_hashes: &mut Vec<Hash>) -> Vec<usize> {
+    let mut next = Vec::with_capacity(active.len());
+    let mut i = 0;
+    while i < active.len() {
+        let p = active[i];
+        // Both children active: they fold into the same parent, so no
+        // sibling is needed. Otherwise the sibling has to be sent.
+        if i + 1 < active.len() && active[i + 1] == (p ^ 1) {
+            i += 2;
+        } else {
+            sibling_hashes.push(tree[level_start + (p ^ 1)]);
+            i += 1;
+        }
+        next.push(p >> 1);
+    }
+    next
+}
